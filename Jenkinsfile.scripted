properties([
  pipelineTriggers([pollSCM('H/2 * * * *')]),
  disableConcurrentBuilds(),
  buildDiscarder(logRotator(numToKeepStr: '10')),
  parameters([
    booleanParam(name: 'DEPLOY', defaultValue: true,
      description: 'Publish to the local lab preview')
  ])
])

node {
  timeout(time: 10, unit: 'MINUTES') {
    withEnv(['LAB_DEPLOY_ROOT=C:/JenkinsLab/node-cicd']) {
      try {
        stage('Checkout') { checkout scm }
        stage('Install') { bat 'npm.cmd ci' }
        stage('Test') { bat 'npm.cmd test' }
        stage('Build') { bat 'npm.cmd run build' }
        stage('Archive') {
          archiveArtifacts artifacts: 'dist/**', fingerprint: true
        }
        if (params.DEPLOY != false) {
          stage('Approval') {
            timeout(time: 2, unit: 'MINUTES') {
              input message: 'Deploy this tested build?', ok: 'Deploy'
            }
          }
          stage('Deploy') {
            bat 'npm.cmd run deploy -- scripted'
          }
        } else {
          echo 'Approval and deployment skipped by parameter'
        }
        echo 'CI passed. Check the Deploy stage for publication.'
      } catch (err) {
        echo 'Failed. Inspect Console Output before retrying.'
        throw err
      } finally {
        echo "Finished build ${env.BUILD_NUMBER}"
      }
    }
  }
}
